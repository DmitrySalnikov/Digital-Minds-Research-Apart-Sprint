# Copy to .env and fill in whichever you have. All are optional.

# vLLM served locally or on Modal (OpenAI-compatible endpoint)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=dummy

# OpenRouter — has :free models, no card needed for those
OPENROUTER_API_KEY=

# Google AI Studio free tier (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Groq / Cerebras free tiers (both OpenAI-compatible)
GROQ_API_KEY=
CEREBRAS_API_KEY=
